            "body": {
              "mode": "raw",
              "raw": "{\n  \"$ref\": \"#/components/schemas/CreateWebhookSubscriptionRequest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Registers an HTTPS endpoint for catalog events. The response includes a\n`signingSecret` exactly once; store it securely and use it to verify\n`X-Catalog-Signature`. Only catalog administrators and services may\ncreate subscriptions.\n"
        },
        {
          "name": "List webhook deliveries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/webhooks/deliveries",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "webhooks",
                "deliveries"
              ],
              "protocol": "https"
            }
          },
          "description": "Returns a paginated list of webhook delivery attempts. Filter by\nsubscription, event, status, or event type. Only catalog administrators\nand services may inspect deliveries.\n"
        }
      ]
    },
