    {
      "name": "Prerequisites",
      "item": [
        {
          "name": "Replace course prerequisites",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/courses/:courseId/prerequisites",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "courses",
                ":courseId",
                "prerequisites"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"$ref\": \"#/components/schemas/PutPrerequisitesRequest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Replaces the complete prerequisite set for a course. The operation is\natomic. A course cannot list itself, duplicate a course, or introduce a\nprerequisite cycle. Only catalog administrators and services may update\nprerequisites.\n"
        },
        {
          "name": "Check direct prerequisites against completed courses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/prerequisites/check",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "prerequisites",
                "check"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"$ref\": \"#/components/schemas/PrerequisiteCheckRequest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Evaluates a stateless eligibility check from the supplied completed\ncourse IDs. Only direct prerequisite rules marked required are\nconsidered; optional prerequisites never block eligibility. Grades and\nstudent records are not read. All authenticated roles may call this\noperation.\n"
        },
        {
          "name": "Check prerequisite eligibility",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/courses/:courseId/eligibility-check",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "courses",
                ":courseId",
                "eligibility-check"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"$ref\": \"#/components/schemas/EligibilityCheckRequest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Evaluates whether a student satisfies the prerequisites for a course.\nStudents may only check their own `studentId`; instructors, catalog\nadministrators, and services may check any student. This\nstudent-record-based operation remains part of the long-term contract\nbut is not implemented by the current Worker. Use\n`POST /v1/prerequisites/check` for stateless direct-prerequisite\nchecks.\n"
        }
      ]
    },
