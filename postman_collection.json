  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign in with Student Identity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/auth/login",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"studentId\",\n    \"password\"\n  ],\n  \"properties\": {\n    \"studentId\": {\n      \"type\": \"string\",\n      \"pattern\": \"^\\\\d{10}$\"\n    },\n    \"password\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"maxLength\": 1024\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Forwards student credentials to Student Identity and returns a short-lived identity token after verification. Credentials are not stored by Course Catalog."
        },
        {
          "name": "Create a Student Identity account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/auth/signup",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "auth",
                "signup"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"studentId\",\n    \"firstName\",\n    \"lastName\",\n    \"email\",\n    \"password\"\n  ],\n  \"properties\": {\n    \"studentId\": {\n      \"type\": \"string\",\n      \"pattern\": \"^\\\\d{10}$\"\n    },\n    \"firstName\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"maxLength\": 100\n    },\n    \"lastName\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"maxLength\": 100\n    },\n    \"email\": {\n      \"type\": \"string\",\n      \"format\": \"email\"\n    },\n    \"faculty\": {\n      \"type\": \"string\",\n      \"maxLength\": 120\n    },\n    \"password\": {\n      \"type\": \"string\",\n      \"minLength\": 8,\n      \"maxLength\": 1024\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Forwards student account details to Student Identity. On success, returns a verified short-lived token and signs the new student in."
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List or search courses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/courses",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "courses"
              ],
              "protocol": "https"
            }
          },
          "description": "Returns a paginated list of courses. The `q` parameter searches course\ncode, title, and description. All authenticated roles may call this\noperation.\n"
        },
        {
          "name": "Create a course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/courses",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "courses"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"$ref\": \"#/components/schemas/CreateCourseRequest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Creates a draft course. Only catalog administrators and services may create courses."
        },
        {
          "name": "Get a course",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/courses/:courseId",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "courses",
                ":courseId"
              ],
              "protocol": "https"
            }
          },
          "description": "Returns a single course by ID. All authenticated roles may call this operation."
        },
        {
          "name": "Update a course",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/courses/:courseId",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "courses",
                ":courseId"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"$ref\": \"#/components/schemas/UpdateCourseRequest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Applies a partial update to a course. At least one field must be\npresent. Publishing is a separate operation. Only catalog\nadministrators and services may update courses.\n"
        },
        {
          "name": "Publish a course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{catalog_token}}"
              }
            ],
            "url": {
              "raw": "https://course-catalog.taskflow-123.workers.dev/v1/courses/:courseId/publish",
              "host": [
                "course-catalog.taskflow-123.workers.dev"
              ],
              "path": [
                "v1",
                "courses",
                ":courseId",
                "publish"
              ],
              "protocol": "https"
            }
          },
          "description": "Publishes a draft course and emits a `course.published` version `1.0`\nwebhook event. A published course requires at least one instructor and\nno unsatisfied catalog validation errors. Only catalog administrators\nand services may publish courses.\n"
        }
      ]
    },
