{
  "info": {
    "name": "Course Catalog API",
    "description": "Postman/Bruno collection for the Course Catalog API. Generated from openapi.yaml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://course-catalog.taskflow-123.workers.dev"
    },
    {
      "key": "catalog_token",
      "value": ""
    },
    {
      "key": "course_id",
      "value": ""
    },
    {
      "key": "instructor_id",
