{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook-receiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "vars": {
    "WEBHOOK_SIGNING_SECRET": "replace-with-the-subscriptions-signing-secret"
  },
  "secrets": {
    "required": ["WEBHOOK_SIGNING_SECRET"]
  }
}
