{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "course-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "course-catalog",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "env": {
    "staging": {
      "name": "course-catalog-staging",
      "vars": {
        "APP_VERSION": "0.1.0",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "course-catalog-staging",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "course-catalog",
      "vars": {
        "APP_VERSION": "0.1.0",
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "course-catalog-production",
          "database_id": "00000000-0000-4000-8000-000000000003",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
